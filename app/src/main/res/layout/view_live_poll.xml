<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/live_poll_panel"
    android:layout_width="@dimen/live_chat_panel_width"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_live_chat_panel"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/live_chat_edge_padding"
    android:paddingBottom="12dp"
    android:visibility="gone"
    tools:visibility="visible">

    <LinearLayout
        android:id="@+id/live_poll_header_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_poll_option_selector"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/live_poll_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/live_poll"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/live_poll_collapse_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:text="@string/live_poll_collapse_symbol"
            android:textColor="@android:color/white"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/live_poll_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/live_poll_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="10dp"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Which segment next?" />

        <ScrollView
            android:id="@+id/live_poll_options_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fadeScrollbars="false"
            android:fadingEdgeLength="16dp"
            android:fillViewport="false"
            android:maxHeight="@dimen/live_poll_options_max_height"
            android:overScrollMode="ifContentScrolls"
            android:requiresFadingEdge="vertical"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/live_poll_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <TextView
            android:id="@+id/live_poll_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            tools:text="Select an option to vote" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/live_poll_dismiss_timer"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="10dp"
        android:indeterminate="false"
        android:max="1000"
        android:progress="1000"
        android:progressDrawable="@drawable/bg_poll_dismiss_timer"
        android:visibility="gone"
        tools:progress="650"
        tools:visibility="visible" />

</LinearLayout>
